{
  "name": "orbit-ics",
  "version": "1.0.0",
  "private": true,
  "description": "ORBIT Approach iCalendar feed — Cloud Functions gen2 HTTP endpoint",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "gcp-build": "tsc",
    "start": "npm run build && functions-framework --target=orbitIcs --source=dist",
    "test": "vitest run",
    "deploy": "gcloud functions deploy orbitIcs --gen2 --runtime=nodejs22 --region=us-central1 --source=. --entry-point=orbitIcs --trigger-http --allow-unauthenticated"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
